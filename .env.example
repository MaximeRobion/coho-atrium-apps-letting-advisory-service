# Required for hosting-shaped runs (npm start). Not needed for npm run dev.
ATRIUM_SETUP_SECRET=

# SQLite directory (default ./data locally, /data in the image).
ATRIUM_DATA_DIR=./data

PORT=8080

# Quick view iframe parents (Content-Security-Policy frame-ancestors).
# On Hosting, COHO injects ATRIUM_FRAME_ANCESTORS and ATRIUM_PARENT_ORIGIN.
# ATRIUM_FRAME_ANCESTORS=https://applabs.coho.management http://localhost:4200
# ATRIUM_PARENT_ORIGIN=http://localhost:4200

# Optional: restrict lifecycle.setup apiBaseUrl hostnames. Unset = any public https host.
# ATRIUM_API_HOST_ALLOWLIST=apilabs.coho.life,apilabs.coho.management

# COHO Public API base URL is NOT an env var — Store sends data.apiBaseUrl on setup.

# --- Tawk.to (Hosting injects these; never commit real values) ---
# Public embed IDs (also appear in https://embed.tawk.to/{propertyId}/{widgetId}).
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
# Secure Mode API key from Tawk admin (JavaScript API). Leave empty to show the
# widget without Tawk_API.login — required for hashed visitor identity.
TAWK_API_KEY=

# Fail-closed local UI: both must be set for unsigned /ui.
# ATRIUM_DEV_MODE=1
# NODE_ENV=development
